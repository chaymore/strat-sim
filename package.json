{
  "name": "strat-sim",
  "version": "0.0.1",
  "private": true,
  "description": "Multiplayer strategy game for teaching business strategy",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "sim:demo": "pnpm --filter @strat-sim/sim demo",
    "sim:calibrate": "pnpm --filter @strat-sim/sim calibrate",
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @strat-sim/web dev",
    "dev:server": "pnpm --filter @strat-sim/server dev",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
